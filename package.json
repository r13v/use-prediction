{
  "name": "use-prediction",
  "version": "0.0.4",
  "description": "Copilot-like inline predictions for input and textarea fields in React",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "hook",
    "autocomplete",
    "prediction",
    "copilot",
    "input",
    "textarea"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "lint": "eslint \"{src,lib}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"{src,lib}/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --project tsconfig.json",
    "package:lint": "publint --strict && attw --pack . --profile node16",
    "package:check": "npm run build && npm run package:lint",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run package:lint",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r13v/use-prediction.git"
  },
  "bugs": {
    "url": "https://github.com/r13v/use-prediction/issues"
  },
  "homepage": "https://github.com/r13v/use-prediction#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.8.7",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.41.0",
    "eslint-kit": "^10.0.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "prettier": "^3.0.0",
    "publint": "^0.3.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
