{
  "name": "use-prediction",
  "version": "0.0.4",
  "description": "Inline AI suggestions (ghost text) for existing React input and textarea fields",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "hook",
    "autocomplete",
    "prediction",
    "copilot",
    "input",
    "textarea"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "lint": "eslint \"{src,lib,examples,e2e,bench}/**/*.{ts,tsx}\" \"*.config.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run && REACT_VERSION=19 vitest run",
    "test:e2e": "playwright test",
    "test:react19:install": "npm ci --prefix test/react-19",
    "bench": "tsx bench/compare.ts",
    "package:lint": "publint --strict && attw --pack . --profile node16",
    "package:check": "npm run build && npm run package:lint",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run package:lint",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r13v/use-prediction.git"
  },
  "bugs": {
    "url": "https://github.com/r13v/use-prediction/issues"
  },
  "homepage": "https://github.com/r13v/use-prediction#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.41.0",
    "eslint-kit": "^10.0.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "form-please": "^1.12.2",
    "jsdom": "^30.1.3",
    "openai": "^7.42.0",
    "prettier": "^3.0.0",
    "publint": "^0.3.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.90.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15",
    "typescript": "^5.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
